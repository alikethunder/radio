/*
save as lib/systemd/system/radiobestssr.service
systemctl daemon-reload
systemctl restart radiobestssr
*/
this will overwrite settings in .env

[Unit]
Description=radio.best.ssr

[Service]
Environment=NODE_ENV=production
Restart=always
ExecStart=/root/.bun/bin/bun --env-file=.env.production run index.ts
WorkingDirectory=/home/radio/frontend/server

StandardOutput=null
StandardError=syslog
SyslogIdentifier=radiobestssr

[Install]
WantedBy=multi-user.target