/*
save as lib/systemd/system/radiobestssr.service
systemctl daemon-reload
systemctl restart radiobestssr
*/
this will overwrite settings in .env

[Unit]
Description=radio.best.ssr

[Service]
Environment=TEMPL_PATH=/home/radio/frontend/server
Environment=PORT=5454
Environment=ENV=prod
Restart=always
ExecStart=/root/.bun/bin/bun run index.ts
WorkingDirectory=/home/radio/frontend/server

StandardOutput=null
StandardError=syslog
SyslogIdentifier=radiobestssr

[Install]
WantedBy=multi-user.target