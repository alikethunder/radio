/*
save as lib/systemd/system/radiobest.service
systemctl daemon-reload
systemctl restart radiobest
*/
this will overwrite settings in .env

[Unit]
Description=radio.best

[Service]
Environment=TEMPL_PATH=/home/radio
Environment=PORT=80
Environment=ENV=prod
Restart=always
ExecStart=/home/radio/build/main
WorkingDirectory=/home/radio

StandardOutput=null
StandardError=syslog
SyslogIdentifier=radiobest

[Install]
WantedBy=multi-user.target